.results-dashboard {
    --results-color-background: rgb(7, 13, 20);
    --results-color-surface: rgb(12, 25, 36);
    --results-color-surface-raised: rgb(18, 34, 47);
    --results-color-border: rgb(31, 68, 94);
    --results-color-border-strong: rgb(29, 119, 181);
    --results-color-accent: rgb(25, 145, 255);
    --results-color-accent-soft: rgb(11, 62, 101);
    --results-color-text: rgb(232, 240, 247);
    --results-color-text-muted: rgb(142, 165, 185);
    --results-color-grid: rgb(27, 59, 78);
    --results-radius: 6px;
    --results-space-xs: 4px;
    --results-space-sm: 8px;
    --results-space-md: 12px;
    --results-space-lg: 16px;

    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--results-space-md);
    color: var(--results-color-text);
    background-color: var(--results-color-background);
}

.results-surface,
.results-panel {
    min-width: 0;
    min-height: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--results-color-border);
    border-right-color: var(--results-color-border);
    border-top-color: var(--results-color-border);
    border-bottom-color: var(--results-color-border);
    border-top-left-radius: var(--results-radius);
    border-top-right-radius: var(--results-radius);
    border-bottom-left-radius: var(--results-radius);
    border-bottom-right-radius: var(--results-radius);
    background-color: var(--results-color-surface);
}

.results-panel {
    padding: var(--results-space-md);
}

.results-dashboard__top-bar {
    flex-basis: 7%;
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 44px;
    margin-bottom: var(--results-space-sm);
    padding-left: var(--results-space-lg);
    padding-right: var(--results-space-lg);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(27, 34, 45);
    border-left-color: rgb(36, 67, 88);
    border-right-color: rgb(36, 67, 88);
    border-top-color: rgb(36, 67, 88);
    border-bottom-color: rgb(45, 104, 139);
}

.results-header__brand,
.results-header__metadata {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.results-header__brand {
    flex-grow: 1;
    flex-shrink: 1;
}

.results-header__brand-mark {
    flex-grow: 0;
    flex-shrink: 0;
    width: 48px;
    height: 30px;
    margin-right: 10px;
    color: rgb(255, 255, 255);
    background-color: rgb(10, 119, 232);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.top-bar__title-group {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: center;
}

.results-header__title {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.results-header__metadata {
    flex-grow: 0;
    flex-shrink: 1;
}

.top-bar__info-chip {
    flex-grow: 0;
    flex-shrink: 1;
    width: 150px;
    min-width: 70px;
    max-width: 190px;
    height: 36px;
    margin-left: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 9px;
    padding-right: 9px;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(14, 33, 44);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(36, 67, 88);
    border-right-color: rgb(36, 67, 88);
    border-top-color: rgb(36, 67, 88);
    border-bottom-color: rgb(36, 67, 88);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.top-bar__info-chip--case {
    width: 220px;
    min-width: 100px;
    max-width: 250px;
}

.top-bar__info-caption {
    flex-grow: 0;
    flex-shrink: 0;
    height: 11px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(155, 174, 194);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.top-bar__info-value {
    flex-grow: 0;
    flex-shrink: 0;
    height: 17px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(232, 240, 247);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.top-bar__clock {
    flex-grow: 0;
    flex-shrink: 1;
    width: 158px;
    min-width: 110px;
    margin-left: 10px;
    color: rgb(155, 174, 194);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.top-bar__state {
    flex-grow: 0;
    flex-shrink: 0;
    height: 30px;
    min-width: 82px;
    margin-left: 6px;
    padding-left: 9px;
    padding-right: 9px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(14, 33, 44);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(36, 67, 88);
    border-right-color: rgb(36, 67, 88);
    border-top-color: rgb(36, 67, 88);
    border-bottom-color: rgb(36, 67, 88);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.top-bar__state-indicator {
    width: 9px;
    height: 9px;
    margin-right: 7px;
    background-color: rgb(155, 174, 194);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.top-bar__state-value {
    color: rgb(155, 174, 194);
    font-size: 11px;
    -unity-font-style: bold;
}

.top-bar__state--running .top-bar__state-indicator {
    background-color: rgb(55, 214, 139);
}

.top-bar__state--running .top-bar__state-value {
    color: rgb(55, 214, 139);
}

.top-bar__state--paused .top-bar__state-indicator {
    background-color: rgb(255, 183, 77);
}

.top-bar__state--paused .top-bar__state-value {
    color: rgb(255, 183, 77);
}

.top-bar__state--completed .top-bar__state-indicator {
    background-color: rgb(51, 179, 242);
}

.top-bar__state--completed .top-bar__state-value {
    color: rgb(51, 179, 242);
}

.top-bar__state--error .top-bar__state-indicator {
    background-color: rgb(255, 92, 103);
}

.top-bar__state--error .top-bar__state-value {
    color: rgb(255, 92, 103);
}

.results-dashboard__navigation {
    flex-basis: 7%;
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 40px;
    margin-bottom: var(--results-space-sm);
    padding-top: 0;
    padding-bottom: 0;
    padding-left: var(--results-space-sm);
    padding-right: var(--results-space-sm);
    flex-direction: row;
    align-items: center;
    background-color: rgb(27, 34, 45);
    border-left-color: rgb(36, 67, 88);
    border-right-color: rgb(36, 67, 88);
    border-top-color: rgb(36, 67, 88);
    border-bottom-color: rgb(36, 67, 88);
}

.results-navigation__item {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 72%;
    margin-left: var(--results-space-xs);
    margin-right: var(--results-space-xs);
    padding-left: var(--results-space-sm);
    padding-right: var(--results-space-sm);
    color: rgb(155, 174, 194);
    background-color: rgba(9, 12, 17, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 2px;
    border-left-color: rgba(45, 104, 139, 0);
    border-right-color: rgba(45, 104, 139, 0);
    border-top-color: rgba(45, 104, 139, 0);
    border-bottom-color: rgba(45, 104, 139, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 14px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.results-navigation__item:hover {
    color: rgb(232, 240, 247);
    background-color: rgb(31, 47, 61);
    border-bottom-color: rgb(45, 104, 139);
}

.results-navigation__item.results-navigation__item--selected {
    color: rgb(255, 255, 255);
    background-color: rgb(10, 119, 232);
    border-left-color: rgb(51, 179, 242);
    border-right-color: rgb(51, 179, 242);
    border-top-color: rgb(51, 179, 242);
    border-bottom-color: rgb(112, 218, 255);
    -unity-font-style: bold;
}

.results-navigation__item:disabled,
.results-navigation__item:disabled:hover {
    opacity: 0.38;
    color: rgb(155, 174, 194);
    background-color: rgba(9, 12, 17, 0);
    border-left-color: rgba(45, 104, 139, 0);
    border-right-color: rgba(45, 104, 139, 0);
    border-top-color: rgba(45, 104, 139, 0);
    border-bottom-color: rgba(45, 104, 139, 0);
}

.results-page {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.result-variable-tabs {
    flex-basis: 6.5%;
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 42px;
    margin-bottom: var(--results-space-sm);
    padding: 3px;
    flex-direction: row;
    align-items: stretch;
}

.result-variable-tab {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding: 0 6px;
    color: var(--results-color-text-muted);
    background-color: rgb(13, 31, 44);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-left-color: var(--results-color-border);
    border-right-color: var(--results-color-border);
    border-bottom-color: rgb(17, 46, 64);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    font-size: 11px;
    -unity-font-style: bold;
}

.result-variable-tab:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(16, 48, 69);
}

.result-variable-tab--selected {
    color: rgb(255, 255, 255);
    background-color: var(--results-color-accent);
    border-left-color: rgb(77, 185, 255);
    border-right-color: rgb(77, 185, 255);
    border-bottom-color: rgb(119, 208, 255);
}

.result-variable-tab--unsupported,
.result-variable-tab--unsupported:hover,
.result-variable-tab--unsupported:disabled {
    color: rgb(78, 98, 115);
    background-color: rgb(11, 25, 35);
    border-left-color: rgb(24, 50, 67);
    border-right-color: rgb(24, 50, 67);
    border-bottom-color: rgb(24, 50, 67);
    opacity: 1;
}

.results-workspace {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
}

.results-workspace__main-column {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    margin-right: var(--results-space-sm);
}

.results-scene-area {
    flex-basis: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 280px;
    margin-bottom: 0;
    flex-direction: row;
}

.scene-tool-rail {
    flex-grow: 0;
    flex-shrink: 0;
    width: 54px;
    margin-right: var(--results-space-sm);
    padding: 6px;
    align-items: stretch;
}

.scene-tool-button {
    flex-grow: 0;
    flex-shrink: 1;
    height: 42px;
    min-height: 28px;
    margin: 0 0 6px 0;
    padding: 0;
    color: var(--results-color-text-muted);
    background-color: rgb(18, 40, 55);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--results-color-border);
    border-right-color: var(--results-color-border);
    border-top-color: var(--results-color-border);
    border-bottom-color: var(--results-color-border);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    font-size: 9px;
    -unity-font-style: bold;
}

.scene-tool-button:hover,
.scene-tool-button--selected {
    color: rgb(255, 255, 255);
    background-color: var(--results-color-accent-soft);
    border-left-color: var(--results-color-accent);
    border-right-color: var(--results-color-accent);
    border-top-color: var(--results-color-accent);
    border-bottom-color: var(--results-color-accent);
}

.scene-tool-rail__spacer {
    flex-grow: 1;
    min-height: 0;
}

.results-scene-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding: 0;
    overflow: hidden;
}

.results-scene-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    position: relative;
    overflow: hidden;
    background-color: rgb(7, 20, 29);
}

.results-scene-viewport__image,
.results-scene-viewport__placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.results-scene-viewport__image {
    -unity-background-scale-mode: scale-and-crop;
}

.results-scene-viewport__placeholder {
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 22, 31, 0.64);
}

.results-scene-viewport__placeholder-title {
    color: rgb(56, 107, 137);
    font-size: 22px;
    letter-spacing: 4px;
    -unity-font-style: bold;
}

.results-scene-viewport__placeholder-status {
    margin-top: 8px;
    color: rgb(94, 125, 145);
    font-size: 10px;
}

.scene-control-panel {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 270px;
    padding: 10px;
    background-color: rgba(9, 27, 39, 0.94);
}

.scene-control-panel__row {
    min-width: 0;
    min-height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.scene-control-panel__row--slider {
    margin-top: 7px;
}

.scene-control-panel__label,
.scene-control-panel__value {
    color: var(--results-color-text-muted);
    font-size: 10px;
    -unity-font-style: bold;
}

.scene-control-panel__title {
    height: 20px;
    color: rgb(242, 248, 252);
    font-size: 11px;
    -unity-font-style: bold;
}

.slice-plane-row {
    flex-grow: 0;
    flex-shrink: 0;
    height: 29px;
    margin-top: 4px;
    flex-direction: row;
    align-items: center;
}

.slice-plane-toggle {
    flex-grow: 0;
    flex-shrink: 0;
    width: 76px;
    height: 24px;
    margin: 0 5px 0 0;
    color: var(--results-color-text);
    font-size: 9px;
}

.slice-plane-slider {
    flex-grow: 1;
    min-width: 70px;
    height: 18px;
    margin: 0 5px 0 0;
}

.slice-plane-value {
    flex-grow: 0;
    flex-shrink: 0;
    width: 30px;
    color: var(--results-color-text);
    font-size: 9px;
    -unity-text-align: middle-right;
}

.scene-control-panel__label--section {
    margin-top: 9px;
    margin-bottom: 5px;
}

.scene-control-panel__value {
    color: var(--results-color-text);
}

.scene-control-panel__dropdown,
.scene-toolbar__mode-field {
    height: 24px;
    color: var(--results-color-text);
}

.scene-control-panel__dropdown {
    width: 126px;
}

.results-dashboard .unity-base-popup-field__input,
.results-dashboard .unity-popup-field__input,
.results-dashboard .unity-base-field__input,
.results-dashboard .unity-base-text-field__input {
    min-height: 22px;
    padding-top: 0;
    padding-bottom: 0;
    color: var(--results-color-text);
    background-color: rgb(19, 42, 57);
    border-left-color: rgb(45, 83, 108);
    border-right-color: rgb(45, 83, 108);
    border-top-color: rgb(45, 83, 108);
    border-bottom-color: rgb(45, 83, 108);
    font-size: 10px;
}

.results-dashboard .unity-base-popup-field__text,
.results-dashboard .unity-popup-field__text {
    color: var(--results-color-text);
    font-size: 10px;
}

.slice-axis-toolbar {
    height: 30px;
    flex-direction: row;
}

.slice-axis-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 3px 0 0;
    padding: 0;
    color: var(--results-color-text-muted);
    background-color: rgb(19, 42, 57);
    border-left-color: var(--results-color-border);
    border-right-color: var(--results-color-border);
    border-top-color: var(--results-color-border);
    border-bottom-color: var(--results-color-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 11px;
    -unity-font-style: bold;
}

.slice-axis-button--selected {
    color: rgb(255, 255, 255);
    background-color: var(--results-color-accent);
}

.scene-control-panel__slider {
    height: 18px;
    margin: 0 0 5px 0;
}

.scene-control-panel__status {
    min-height: 18px;
    margin-top: 4px;
    color: var(--results-color-text-muted);
    font-size: 8px;
    white-space: normal;
}

.scene-control-panel__status--ready {
    color: rgb(61, 211, 158);
}

.scene-control-panel__toggle {
    height: 24px;
    margin: 2px 0 0 0;
    color: var(--results-color-text);
    font-size: 10px;
}

.results-dashboard .unity-toggle__input {
    width: 28px;
    height: 16px;
    margin-right: 7px;
    background-color: rgb(22, 49, 66);
    border-left-color: rgb(45, 83, 108);
    border-right-color: rgb(45, 83, 108);
    border-top-color: rgb(45, 83, 108);
    border-bottom-color: rgb(45, 83, 108);
}

.results-dashboard .unity-toggle:checked .unity-toggle__input {
    background-color: var(--results-color-accent);
}

.scene-toolbar {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 46px;
    padding: 5px 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(10, 29, 41);
    border-top-width: 1px;
    border-top-color: var(--results-color-border);
}

.scene-toolbar__group,
.scene-toolbar__mode {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.scene-toolbar__group {
    flex-grow: 1;
    flex-shrink: 1;
}

.scene-toolbar-button {
    flex-grow: 0;
    flex-shrink: 1;
    width: 64px;
    min-width: 42px;
    height: 30px;
    margin: 0 5px 0 0;
    padding: 0 5px;
    color: var(--results-color-text-muted);
    background-color: rgb(18, 41, 56);
    border-left-color: var(--results-color-border);
    border-right-color: var(--results-color-border);
    border-top-color: var(--results-color-border);
    border-bottom-color: var(--results-color-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 9px;
    -unity-font-style: bold;
}

.scene-toolbar-button--wide {
    width: 78px;
}

.scene-toolbar-button:hover,
.scene-toolbar-button--selected {
    color: rgb(255, 255, 255);
    background-color: var(--results-color-accent-soft);
    border-left-color: var(--results-color-accent);
    border-right-color: var(--results-color-accent);
    border-top-color: var(--results-color-accent);
    border-bottom-color: var(--results-color-accent);
}

.scene-toolbar__mode {
    flex-grow: 0;
    flex-shrink: 0;
}

.scene-toolbar__mode-label {
    margin-right: 7px;
    color: var(--results-color-text-muted);
    font-size: 9px;
    -unity-font-style: bold;
}

.scene-toolbar__mode-field {
    width: 116px;
}

.scene-toolbar__hint {
    flex-grow: 0;
    flex-shrink: 0;
    color: var(--results-color-text-muted);
    font-size: 8px;
}

.probe-analytics-panel {
    flex-basis: 36%;
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 170px;
    padding: 10px 12px;
}

.probe-analytics-panel__header,
.results-panel__heading-row,
.probe-chart-legend {
    flex-direction: row;
    align-items: center;
}

.probe-analytics-panel__header {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 34px;
    justify-content: space-between;
}

.results-panel__title {
    color: rgb(242, 248, 252);
    font-size: 12px;
    -unity-font-style: bold;
}

.results-panel__subtitle,
.results-panel__unit {
    color: var(--results-color-text-muted);
    font-size: 9px;
}

.results-panel__subtitle {
    margin-top: 2px;
}

.results-panel__unit {
    margin-left: 5px;
}

.probe-chart-legend {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
}

.probe-chart-legend__swatch {
    width: 14px;
    height: 3px;
    margin-left: 12px;
    margin-right: 4px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.probe-chart-legend__swatch--temperature {
    background-color: rgb(255, 86, 102);
}

.probe-chart-legend__swatch--velocity {
    background-color: rgb(45, 200, 255);
}

.probe-chart-legend__swatch--pressure {
    background-color: rgb(255, 195, 61);
}

.probe-chart-legend__label {
    color: var(--results-color-text-muted);
    font-size: 9px;
    white-space: nowrap;
}

.probe-chart {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 4px;
    flex-direction: row;
}

.probe-chart__y-axis {
    width: 28px;
    padding-top: 2px;
    padding-bottom: 2px;
    justify-content: space-between;
}

.probe-chart__plot {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    position: relative;
    overflow: hidden;
    background-color: rgb(7, 20, 30);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--results-color-grid);
    border-right-color: var(--results-color-grid);
    border-top-color: var(--results-color-grid);
    border-bottom-color: var(--results-color-grid);
}

.probe-chart__grid-line,
.probe-chart__preview-line,
.probe-chart__empty-state {
    position: absolute;
    left: 0;
    right: 0;
}

.probe-chart__grid-line {
    height: 1px;
    background-color: var(--results-color-grid);
}

.probe-chart__grid-line--top {
    top: 25%;
}

.probe-chart__grid-line--middle {
    top: 50%;
}

.probe-chart__grid-line--bottom {
    top: 75%;
}

.probe-chart__preview-line {
    right: 5%;
    height: 2px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.probe-chart__preview-line--temperature {
    top: 43%;
    background-color: rgb(255, 86, 102);
}

.probe-chart__preview-line--velocity {
    top: 59%;
    background-color: rgb(45, 200, 255);
}

.probe-chart__empty-state {
    top: 8px;
    color: rgb(79, 112, 132);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.probe-chart__x-axis {
    height: 20px;
    margin-left: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.probe-chart__axis-value,
.probe-chart__axis-title {
    color: var(--results-color-text-muted);
    font-size: 8px;
}

.probe-chart__axis-title {
    -unity-font-style: bold;
}

.results-analytics-sidebar {
    flex-grow: 0;
    flex-shrink: 1;
    width: 330px;
    min-width: 280px;
    min-height: 0;
}

.result-legend-panel {
    flex-basis: auto;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-bottom: 0;
}

.results-panel__heading-row {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 22px;
    padding-top: 2px;
    align-items: center;
}

.result-variable-metadata {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 38px;
    margin-top: 7px;
    flex-direction: row;
    background-color: rgb(10, 29, 41);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--results-color-grid);
    border-right-color: var(--results-color-grid);
    border-top-color: var(--results-color-grid);
    border-bottom-color: var(--results-color-grid);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.result-variable-metadata__item {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 3px 5px;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: var(--results-color-grid);
}

.result-variable-metadata__item--range {
    flex-grow: 1.8;
    border-right-width: 0;
}

.result-variable-metadata__caption,
.result-variable-metadata__value {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.result-variable-metadata__caption {
    color: var(--results-color-text-muted);
    font-size: 7px;
    -unity-font-style: bold;
}

.result-variable-metadata__value {
    margin-top: 1px;
    color: var(--results-color-text);
    font-size: 9px;
    -unity-font-style: bold;
}

.result-variable-status {
    flex-grow: 0;
    flex-shrink: 0;
    height: 17px;
    margin-top: 4px;
    color: var(--results-color-text-muted);
    font-size: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.result-variable-status--ready {
    color: rgb(61, 211, 158);
}

.color-map-controls {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 6px;
    padding: 5px 6px 4px 6px;
    background-color: rgb(10, 29, 41);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--results-color-grid);
    border-right-color: var(--results-color-grid);
    border-top-color: var(--results-color-grid);
    border-bottom-color: var(--results-color-grid);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.color-map-controls__row {
    height: 24px;
    flex-direction: row;
    align-items: center;
}

.color-map-controls__row--range {
    margin-top: 3px;
}

.color-map-controls__label {
    flex-grow: 0;
    flex-shrink: 0;
    width: 49px;
    color: var(--results-color-text-muted);
    font-size: 8px;
    -unity-font-style: bold;
}

.color-map-controls__preset {
    flex-grow: 1;
    min-width: 0;
    height: 22px;
    font-size: 9px;
}

.color-range-mode-toolbar {
    flex-grow: 0;
    flex-shrink: 0;
    width: 89px;
    height: 22px;
    flex-direction: row;
}

.color-range-mode-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 22px;
    margin: 0;
    padding: 0 3px;
    color: var(--results-color-text-muted);
    background-color: rgb(17, 41, 55);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--results-color-grid);
    border-right-color: var(--results-color-grid);
    border-top-color: var(--results-color-grid);
    border-bottom-color: var(--results-color-grid);
    font-size: 8px;
}

.color-range-mode-button--selected {
    color: rgb(230, 248, 255);
    background-color: rgb(24, 99, 142);
    border-left-color: rgb(55, 181, 239);
    border-right-color: rgb(55, 181, 239);
    border-top-color: rgb(55, 181, 239);
    border-bottom-color: rgb(55, 181, 239);
}

.color-range-field {
    flex-grow: 1;
    min-width: 0;
    height: 22px;
    margin-left: 4px;
    font-size: 8px;
}

.color-range-field .unity-base-field__label {
    min-width: 20px;
    padding-right: 2px;
    color: var(--results-color-text-muted);
}

.color-range-field .unity-base-text-field__input {
    padding-left: 3px;
    padding-right: 3px;
    color: var(--results-color-text);
    background-color: rgb(17, 41, 55);
}

.color-map-status {
    height: 14px;
    margin-top: 3px;
    color: var(--results-color-text-muted);
    font-size: 7px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.color-map-status--error {
    color: rgb(255, 146, 121);
}

.color-map-status--ready {
    color: rgb(61, 211, 158);
}

.result-legend__body {
    flex-grow: 1;
    min-height: 0;
    margin-top: 8px;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
}

.result-legend__bar {
    flex-grow: 0;
    flex-shrink: 0;
    width: 44px;
    min-height: 0;
    margin-right: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(84, 111, 130);
    border-right-color: rgb(84, 111, 130);
    border-top-color: rgb(84, 111, 130);
    border-bottom-color: rgb(84, 111, 130);
}

.result-legend__segment {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.result-legend__segment--red { background-color: rgb(255, 35, 46); }
.result-legend__segment--orange { background-color: rgb(255, 126, 30); }
.result-legend__segment--yellow { background-color: rgb(255, 235, 54); }
.result-legend__segment--green { background-color: rgb(49, 215, 91); }
.result-legend__segment--cyan { background-color: rgb(21, 188, 231); }
.result-legend__segment--blue { background-color: rgb(37, 61, 230); }

.result-legend__labels {
    flex-grow: 0;
    width: 40px;
    justify-content: space-between;
}

.result-legend__label {
    color: var(--results-color-text);
    font-size: 11px;
    -unity-font-style: bold;
}

.result-information-panel {
    flex-basis: 27%;
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 156px;
    margin-bottom: var(--results-space-sm);
    padding-bottom: 8px;
}

.result-info__rows {
    flex-grow: 1;
    min-height: 0;
    margin-top: 7px;
}

.result-info__row {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--results-color-grid);
}

.result-info__label,
.result-info__value {
    font-size: 9px;
}

.result-info__label {
    color: var(--results-color-text-muted);
}

.result-info__value {
    color: var(--results-color-text);
    -unity-font-style: bold;
}

.statistics-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 168px;
}

.statistics-table {
    flex-grow: 1;
    min-height: 0;
    margin-top: 7px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--results-color-grid);
    border-right-color: var(--results-color-grid);
    border-top-color: var(--results-color-grid);
    border-bottom-color: var(--results-color-grid);
}

.statistics-table__row {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 22px;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: var(--results-color-grid);
}

.statistics-table__row--header {
    background-color: rgb(17, 41, 56);
}

.statistics-table__row--unit {
    background-color: rgb(10, 29, 41);
}

.statistics-table__cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    color: var(--results-color-text);
    border-right-width: 1px;
    border-right-color: var(--results-color-grid);
    font-size: 8px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.statistics-table__cell--label {
    color: var(--results-color-text-muted);
    background-color: rgb(14, 34, 47);
    -unity-font-style: bold;
}

