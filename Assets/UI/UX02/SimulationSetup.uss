}

.run-control__detail {
    flex-grow: 0;
    height: 20px;
    color: var(--simulation-color-text-muted);
    font-size: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.run-control__button-row {
    flex-grow: 0;
    flex-shrink: 0;
    height: 26px;
    flex-direction: row;
}

.run-control__button {
    flex-grow: 0;
    flex-shrink: 0;
    height: 24px;
    margin-bottom: 3px;
    color: var(--simulation-color-text);
    background-color: rgb(24, 48, 65);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--simulation-color-border);
    border-right-color: var(--simulation-color-border);
    border-top-color: var(--simulation-color-border);
    border-bottom-color: var(--simulation-color-border);
    font-size: 9px;
    -unity-font-style: bold;
}

.run-control__button--primary {
    color: rgb(255, 255, 255);
    background-color: var(--simulation-color-accent);
}

.run-control__button--half {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 3px;
}

.run-control__button--last {
    margin-right: 3px;
}

.run-control__button--danger {
    color: rgb(255, 173, 179);
}

.run-control__button:disabled {
    opacity: 0.42;
}

.run-control__status {
    flex-grow: 1;
    min-height: 22px;
    padding-top: 2px;
    color: var(--simulation-color-text-muted);
    font-size: 8px;
    white-space: normal;
}

.run-control__status--error {
    color: rgb(255, 139, 148);
}
