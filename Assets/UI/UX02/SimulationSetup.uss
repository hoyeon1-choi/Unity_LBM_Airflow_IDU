.simulation-setup {
    --simulation-color-background: rgb(8, 13, 20);
    --simulation-color-surface: rgb(14, 25, 36);
    --simulation-color-surface-raised: rgb(19, 34, 48);
    --simulation-color-border: rgb(34, 70, 96);
    --simulation-color-border-strong: rgb(30, 117, 177);
    --simulation-color-accent: rgb(34, 142, 255);
    --simulation-color-accent-soft: rgb(15, 62, 98);
    --simulation-color-success: rgb(24, 211, 143);
    --simulation-color-text: rgb(232, 240, 247);
    --simulation-color-text-muted: rgb(145, 166, 187);
    --simulation-space-xs: 4px;
    --simulation-space-sm: 8px;
    --simulation-space-md: 12px;
    --simulation-space-lg: 16px;
    --simulation-radius: 6px;

    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--simulation-space-md);
    color: var(--simulation-color-text);
    background-color: var(--simulation-color-background);
}

/* UI Toolkit field values live in generated child elements. Styling only the
   UXML field class leaves the Editor theme's light input background and muted
   text in place, which makes dropdown and numeric values effectively invisible. */
.simulation-setup .unity-base-field__input,
.simulation-setup .unity-base-text-field__input,
.simulation-setup .unity-text-input,
.simulation-setup #unity-text-input,
.simulation-setup .unity-base-popup-field__input,
.simulation-setup .unity-popup-field__input {
    min-height: 22px;
    padding-top: 0;
    padding-bottom: 0;
    color: var(--simulation-color-text);
    background-color: rgb(24, 43, 58);
    border-left-color: rgb(48, 83, 108);
    border-right-color: rgb(48, 83, 108);
    border-top-color: rgb(48, 83, 108);
    border-bottom-color: rgb(48, 83, 108);
    font-size: 10px;
    -unity-text-align: middle-left;
}

.simulation-setup .unity-base-text-field__input,
.simulation-setup .unity-text-input,
.simulation-setup #unity-text-input {
    padding-left: 7px;
    padding-right: 7px;
}

.simulation-setup .unity-base-popup-field__text,
.simulation-setup .unity-popup-field__text {
    padding-left: 7px;
    padding-right: 4px;
    color: var(--simulation-color-text);
    font-size: 10px;
    -unity-text-align: middle-left;
}

.simulation-setup .unity-base-popup-field__arrow,
.simulation-setup .unity-popup-field__arrow {
    -unity-background-image-tint-color: rgb(190, 208, 223);
}

.simulation-setup .unity-base-field:disabled {
    opacity: 1;
}

.simulation-setup .unity-base-field:disabled .unity-base-field__input,
.simulation-setup .unity-base-field:disabled .unity-base-text-field__input,
.simulation-setup .unity-base-field:disabled .unity-text-input,
.simulation-setup .unity-base-field:disabled #unity-text-input,
.simulation-setup .unity-base-field:disabled .unity-base-popup-field__input,
.simulation-setup .unity-base-field:disabled .unity-popup-field__input,
.simulation-setup .unity-base-field:disabled .unity-base-popup-field__text,
.simulation-setup .unity-base-field:disabled .unity-popup-field__text {
    opacity: 1;
    color: rgb(181, 198, 212);
    background-color: rgb(49, 60, 69);
}

.simulation-setup .unity-composite-field__field > .unity-base-field__label {
    color: var(--simulation-color-text-muted);
    font-size: 9px;
}

/* Dropdown menus are attached to the panel overlay rather than below the
   SimulationSetup element, so their generated classes must be styled globally. */
.unity-base-dropdown__container-outer,
.unity-base-dropdown__container-inner {
    color: rgb(232, 240, 247);
    background-color: rgb(19, 34, 48);
    border-left-color: rgb(48, 83, 108);
    border-right-color: rgb(48, 83, 108);
    border-top-color: rgb(48, 83, 108);
    border-bottom-color: rgb(48, 83, 108);
}

.unity-base-dropdown__item,
.unity-base-dropdown__label {
    min-height: 24px;
    color: rgb(232, 240, 247);
    font-size: 10px;
    -unity-text-align: middle-left;
}

.unity-base-dropdown__item:hover,
.unity-base-dropdown__item:checked {
    color: rgb(255, 255, 255);
    background-color: rgb(15, 62, 98);
}

.simulation-setup__top-bar,
.simulation-setup__navigation,
.simulation-page__step-rail,
.simulation-step-panel,
.simulation-operation-panel,
.simulation-page__console {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--simulation-color-border);
    border-right-color: var(--simulation-color-border);
    border-top-color: var(--simulation-color-border);
    border-bottom-color: var(--simulation-color-border);
    border-top-left-radius: var(--simulation-radius);
    border-top-right-radius: var(--simulation-radius);
    border-bottom-left-radius: var(--simulation-radius);
    border-bottom-right-radius: var(--simulation-radius);
    background-color: var(--simulation-color-surface);
}

.simulation-setup__top-bar {
    flex-basis: 7%;
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 44px;
    margin-bottom: var(--simulation-space-sm);
    padding-left: var(--simulation-space-lg);
    padding-right: var(--simulation-space-lg);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(27, 34, 45);
    border-left-color: rgb(36, 67, 88);
    border-right-color: rgb(36, 67, 88);
    border-top-color: rgb(36, 67, 88);
    border-bottom-color: rgb(45, 104, 139);
}

.simulation-setup__brand,
.simulation-setup__header-metadata {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.simulation-setup__brand {
    flex-grow: 1;
    flex-shrink: 1;
}

.simulation-setup__brand-mark {
    flex-grow: 0;
    flex-shrink: 0;
    width: 48px;
    height: 30px;
    margin-right: 10px;
    color: rgb(255, 255, 255);
    background-color: rgb(10, 119, 232);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.top-bar__title-group {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: center;
}

.simulation-setup__title {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.simulation-setup__header-metadata {
    flex-grow: 0;
    flex-shrink: 1;
}

.top-bar__info-chip {
    flex-grow: 0;
    flex-shrink: 1;
    width: 150px;
    min-width: 70px;
    max-width: 190px;
    height: 36px;
    margin-left: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 9px;
    padding-right: 9px;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(14, 33, 44);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(36, 67, 88);
    border-right-color: rgb(36, 67, 88);
    border-top-color: rgb(36, 67, 88);
    border-bottom-color: rgb(36, 67, 88);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.top-bar__info-chip--case {
    width: 220px;
    min-width: 100px;
    max-width: 250px;
}

.top-bar__info-caption {
    flex-grow: 0;
    flex-shrink: 0;
    height: 11px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(155, 174, 194);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.top-bar__info-value {
    flex-grow: 0;
    flex-shrink: 0;
    height: 17px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(232, 240, 247);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.top-bar__clock {
    flex-grow: 0;
    flex-shrink: 1;
    width: 158px;
    min-width: 110px;
    margin-left: 10px;
    color: rgb(155, 174, 194);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.top-bar__state {
    flex-grow: 0;
    flex-shrink: 0;
    height: 30px;
    min-width: 82px;
    margin-left: 6px;
    padding-left: 9px;
    padding-right: 9px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(14, 33, 44);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(36, 67, 88);
    border-right-color: rgb(36, 67, 88);
    border-top-color: rgb(36, 67, 88);
    border-bottom-color: rgb(36, 67, 88);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.top-bar__state-indicator {
    width: 9px;
    height: 9px;
    margin-right: 7px;
    background-color: rgb(155, 174, 194);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.top-bar__state-value {
    color: rgb(155, 174, 194);
    font-size: 11px;
    -unity-font-style: bold;
}

.top-bar__state--running .top-bar__state-indicator {
    background-color: rgb(55, 214, 139);
}

.top-bar__state--running .top-bar__state-value {
    color: rgb(55, 214, 139);
}

.top-bar__state--paused .top-bar__state-indicator {
    background-color: rgb(255, 183, 77);
}

.top-bar__state--paused .top-bar__state-value {
    color: rgb(255, 183, 77);
}

.top-bar__state--completed .top-bar__state-indicator {
    background-color: rgb(51, 179, 242);
}

.top-bar__state--completed .top-bar__state-value {
    color: rgb(51, 179, 242);
}

.top-bar__state--error .top-bar__state-indicator {
    background-color: rgb(255, 92, 103);
}

.top-bar__state--error .top-bar__state-value {
    color: rgb(255, 92, 103);
}

.simulation-setup__navigation {
    flex-basis: 7%;
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 40px;
    margin-bottom: var(--simulation-space-sm);
    padding-left: var(--simulation-space-sm);
    padding-right: var(--simulation-space-sm);
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgb(27, 34, 45);
    border-left-color: rgb(36, 67, 88);
    border-right-color: rgb(36, 67, 88);
    border-top-color: rgb(36, 67, 88);
    border-bottom-color: rgb(36, 67, 88);
}

.simulation-navigation__item {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 72%;
    margin-left: var(--simulation-space-xs);
    margin-right: var(--simulation-space-xs);
    padding-left: 8px;
    padding-right: 8px;
    color: rgb(155, 174, 194);
    background-color: rgba(9, 12, 17, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 2px;
    border-left-color: rgba(45, 104, 139, 0);
    border-right-color: rgba(45, 104, 139, 0);
    border-top-color: rgba(45, 104, 139, 0);
    border-bottom-color: rgba(45, 104, 139, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 14px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.simulation-navigation__item:hover {
    color: rgb(232, 240, 247);
    background-color: rgb(31, 47, 61);
    border-bottom-color: rgb(45, 104, 139);
}

.simulation-navigation__item.simulation-navigation__item--selected {
    color: rgb(255, 255, 255);
    background-color: rgb(10, 119, 232);
    border-left-color: rgb(51, 179, 242);
    border-right-color: rgb(51, 179, 242);
    border-top-color: rgb(51, 179, 242);
    border-bottom-color: rgb(112, 218, 255);
    -unity-font-style: bold;
}

.simulation-navigation__item:disabled,
.simulation-navigation__item:disabled:hover {
    opacity: 0.38;
    color: rgb(155, 174, 194);
    background-color: rgba(9, 12, 17, 0);
    border-left-color: rgba(45, 104, 139, 0);
    border-right-color: rgba(45, 104, 139, 0);
    border-top-color: rgba(45, 104, 139, 0);
    border-bottom-color: rgba(45, 104, 139, 0);
}

.simulation-page {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.simulation-page__workspace {
    flex-basis: 72%;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    margin-bottom: var(--simulation-space-sm);
    flex-direction: row;
}

.simulation-page__step-rail {
    flex-basis: 15%;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 150px;
    max-width: 230px;
    margin-right: var(--simulation-space-sm);
    padding: var(--simulation-space-sm);
}

.simulation-step-item {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 48px;
    max-height: 76px;
    margin-bottom: var(--simulation-space-xs);
    padding-left: var(--simulation-space-md);
    padding-right: var(--simulation-space-md);
    flex-direction: row;
    align-items: center;
    color: var(--simulation-color-text-muted);
    background-color: var(--simulation-color-surface-raised);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.simulation-step-item:hover {
    color: var(--simulation-color-text);
    background-color: rgb(25, 48, 66);
}

.simulation-step-item--selected {
    color: rgb(255, 255, 255);
    background-color: var(--simulation-color-accent-soft);
    border-left-color: var(--simulation-color-accent);
}

.simulation-step-item__number {
    width: 28px;
    margin-right: var(--simulation-space-sm);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.simulation-step-item__label {
    flex-grow: 1;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.simulation-page__step-content {
    flex-grow: 4;
    flex-shrink: 1;
    min-width: 260px;
    min-height: 0;
    margin-right: var(--simulation-space-sm);
}

.simulation-step-panel {
    display: none;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--simulation-space-md);
}

.simulation-step-panel--selected {
    display: flex;
}

.simulation-step-panel__title,
.simulation-operation-panel__title {
    flex-grow: 0;
    flex-shrink: 0;
    height: 34px;
    margin-bottom: var(--simulation-space-sm);
    color: rgb(255, 255, 255);
    border-bottom-width: 1px;
    border-bottom-color: var(--simulation-color-border);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.simulation-step-panel__placeholder,
.simulation-operation-panel__placeholder {
    color: var(--simulation-color-text-muted);
    font-size: 12px;
    white-space: normal;
}

.case-selection__header {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 58px;
    margin-bottom: var(--simulation-space-sm);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--simulation-color-border);
}

.case-selection__heading {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.case-selection__title {
    height: 28px;
    margin-bottom: 0;
    border-bottom-width: 0;
}

.case-selection__subtitle,
.case-selection__section-value {
    color: var(--simulation-color-text-muted);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.case-selection__actions {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.case-action-button {
    height: 30px;
    min-width: 68px;
    margin-left: var(--simulation-space-xs);
    padding-left: var(--simulation-space-sm);
    padding-right: var(--simulation-space-sm);
    color: var(--simulation-color-text);
    background-color: var(--simulation-color-surface-raised);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--simulation-color-border);
    border-right-color: var(--simulation-color-border);
    border-top-color: var(--simulation-color-border);
    border-bottom-color: var(--simulation-color-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 10px;
    -unity-font-style: bold;
}

.case-action-button--primary {
    border-left-color: var(--simulation-color-accent);
    border-right-color: var(--simulation-color-accent);
    border-top-color: var(--simulation-color-accent);
    border-bottom-color: var(--simulation-color-accent);
}

.case-action-button--danger {
    color: rgb(255, 139, 148);
}

.case-action-button:disabled {
    opacity: 0.45;
}

.case-selection__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
}

.case-selection__list-panel,
.case-selection__metadata-panel {
    min-width: 0;
    min-height: 0;
    padding: var(--simulation-space-sm);
    background-color: rgb(10, 21, 31);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--simulation-color-border);
    border-right-color: var(--simulation-color-border);
    border-top-color: var(--simulation-color-border);
    border-bottom-color: var(--simulation-color-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.case-selection__list-panel {
    flex-basis: 45%;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--simulation-space-sm);
}

.case-selection__metadata-panel {
    flex-basis: 55%;
    flex-grow: 1;
    flex-shrink: 1;
}

.case-selection__section-header {
    flex-grow: 0;
    flex-shrink: 0;
    height: 28px;
    margin-bottom: var(--simulation-space-xs);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.case-selection__section-title {
    color: var(--simulation-color-text);
    font-size: 12px;
    -unity-font-style: bold;
}

.case-selection__list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.case-list-item {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 48px;
    margin-bottom: var(--simulation-space-xs);
    padding: var(--simulation-space-sm);
    align-items: stretch;
    color: var(--simulation-color-text-muted);
    background-color: var(--simulation-color-surface-raised);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--simulation-color-border);
    border-right-color: var(--simulation-color-border);
    border-top-color: var(--simulation-color-border);
    border-bottom-color: var(--simulation-color-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.case-list-item:hover {
    color: var(--simulation-color-text);
    background-color: rgb(22, 43, 59);
}

.case-list-item--selected {
    color: rgb(255, 255, 255);
    background-color: var(--simulation-color-accent-soft);
    border-left-color: var(--simulation-color-accent);
}

.case-list-item__name {
    flex-grow: 0;
    color: var(--simulation-color-text);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.case-list-item__summary {
    flex-grow: 0;
    margin-top: 2px;
    color: var(--simulation-color-text-muted);
    font-size: 9px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.case-selection__badge {
    height: 20px;
    padding-left: var(--simulation-space-sm);
    padding-right: var(--simulation-space-sm);
    color: var(--simulation-color-accent);
    background-color: var(--simulation-color-accent-soft);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    font-size: 9px;
    -unity-font-style: bold;
